{
    "layer": "top",
    "position": "top",
    "height": 20,
    "spacing": 8,

    "modules-left": ["sway/workspaces", "sway/mode", "custom/layout"],
    "modules-center": ["custom/privacy", "sway/window"],
    "modules-right": ["network", "pulseaudio", "cpu", "memory", "battery", "clock", /*"custom/clipman", "custom/notif",*/ "tray", "custom/power"],

    "sway/workspaces": {
        //"disable-scroll": true,
        //"all-outputs": true,
        "format": "{name}",
        "on-scroll-up": "swaymsg workspace prev",
        "on-scroll-down": "swaymsg workspace next"
    },

    "sway/window": {
        "max-length": 40
    },

    "battery": {
      "interval": 30,
      "states": {
          "warning": 30,
          "critical": 15
      },
      "format": "{icon} {capacity}%",
      "format-charging": "󰂄 {capacity}%",
      "format-plugged": "󰚥 {capacity}%",
      "format-full": "󰁹 {capacity}%",
      "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },

    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%a %d %b}",
        "tooltip-format": "{:%Y-%m-%d %H:%M}"
    },

    "network": {
        "format-wifi": " {signalStrength}%",
        "format-ethernet": " 󰈀 ",
        "format-disconnected": "  ",
        "tooltip-format": "{essid} ({signalStrength}%)"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": " 󰝟 ",
        "format-icons": {
            "default": ["", "", ""]
        },
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8
    },

    "custom/layout": {
        "exec": "~/.config/waybar/scripts/layout_indicator.sh",
        "return-type": "json",
        "interval": 0.5,
        "format": "{}"
    },
    
    "custom/privacy": {
        "exec": "~/.config/waybar/scripts/privacy_indicator.sh",
        "return-type": "json",
        "interval": 0.5,
        "format": "{}"
    },

    "custom/power": {
        "format": " ⏻ ",
        "on-click": "~/.config/waybar/scripts/power.sh",
        "tooltip": false
    },

    "custom/clipman": {
        "format": " 󰅇 ",
        //"on-click": "sh -c 'cliphist list | rofi -dmenu -display-columns 2 -p \"Clipboard\" -font \"JetBrainsMono Nerd Font Mono 12\" | cliphist decode | wl-copy'",
        "on-click": "sh -c 'exec cliphist list | fuzzel --dmenu | cliphist decode | wl-copy'",
        "tooltip": false
    },

    "custom/notif": {
        "format": "󰂚 {}",
        "on-click": "fnottctl history",
        "on-click-right": "fnottctl dismiss all",
        "tooltip": false,
        "exec": "fnottctl list | wc -l | tr -d ' '",
        "interval": 5,
        "signal": 8
    },

    "cpu": {
        "format": "{usage}% ",
        "interval": 2
    },

    "memory": {
        "format": "{percentage}% ",
        "interval": 2
    }
}

